<?xml version="1.0" encoding="utf-8"?>
<!-- Track Free "Today's progress" widget. 3×2 by default, resizable down to
     a compact 2×2. previewLayout (Android 12+) / previewImage (older pickers)
     show sample data in the widget picker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="220dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/habit_widget_layout"
    android:previewLayout="@layout/habit_widget_preview"
    android:previewImage="@drawable/widget_preview"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen"
    android:resizeMode="horizontal|vertical" />
