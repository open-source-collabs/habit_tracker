<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the logo's deep-teal to green gradient
     (bottom-left to top-right). The artwork is the mipmap foreground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:type="linear"
        android:startColor="@color/brand_teal_dark"
        android:centerColor="@color/brand_teal"
        android:endColor="@color/brand_green" />
</shape>
